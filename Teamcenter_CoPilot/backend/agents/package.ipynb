    "from agents.gtac_rag import query_gtac\n",
    "from agents.code_generator import call_euron_llm\n",
    "\n",
    "def answer_with_gtac(query: str, k: int = 3):\n",
    "    results = query_gtac(query, k=k)\n",
    "    context = \"\\n\\n\".join([r.page_content for r in results])\n",
    "    \n",
    "    messages = [\n",
    "        {\"role\": \"system\", \"content\": \"You are a Teamcenter expert. Use the GTAC documentation provided.\"},\n",
    "        {\"role\": \"user\", \"content\": f\"Question: {query}\\n\\nRelevant context:\\n{context}\"}\n",
    "    ]\n",
    "    \n",
    "    return call_euron_llm(messages)\n",
    "\n"
   ]
